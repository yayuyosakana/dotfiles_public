# install.sh が brew bundle で入れるもの
cask "ghostty"          # ターミナル
cask "font-udev-gothic" # Ghostty の設定が使うフォント
brew "herdr"            # AI エージェント向けの画面分割ツール
brew "starship"         # プロンプト（入力行の表示）
brew "gh"               # GitHub CLI（herdr の gh-pr プラグインが使う）
brew "zsh-autosuggestions"     # 打ちかけのコマンドに履歴の候補を出す
brew "zsh-syntax-highlighting" # コマンドを色分けする（打ち間違いは赤）
brew "zoxide"                  # z <フォルダ名の一部> で行ったことのあるフォルダへ飛ぶ
